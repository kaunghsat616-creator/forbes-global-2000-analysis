      <column caption='Profit to Assets' datatype='real' name='[Calculation_1267517060358151]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit ($B)]) / SUM([Assets ($B)])' />
      </column>
      <column caption='Overall Avg Ratio' datatype='real' name='[Calculation_1267517061009416]' role='measure' type='quantitative'>
